# Database
DB_HOST=localhost
DB_PORT=3307
DB_NAME=phase_2_data_guardian
DB_USERNAME=data_guardian
DB_PASSWORD=change_me_app_password

# Docker MySQL administrator (different from application credentials)
MYSQL_ROOT_PASSWORD=change_me_root_password

# JPA
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# JWT: Base64 encoding of at least 32 random bytes. Example below is for development only.
JWT_SECRET=ZGV2ZWxvcG1lbnQtb25seS1zZWNyZXQtY2hhbmdlLW1lLTEyMzQ1Ng==
JWT_ISSUER=phase-2-data-guardian
JWT_EXPIRATION_SECONDS=3600

# Documentation
API_DOCS_ENABLED=true
